{
  "entities": {
    "VisionState": {
      "title": "Vision State",
      "description": "The current state of the Animus vision node.",
      "type": "object",
      "properties": {
        "district": { "type": "string" },
        "action": { "type": "string" },
        "active": { "type": "boolean" },
        "image": { "type": "string" },
        "coherence": { "type": "number" },
        "loot_detected": { "type": "string" },
        "sequence": { "type": "string" },
        "fragment_id": { "type": "string" },
        "sync_status": { "type": "string" }
      }
    },
    "VaultItem": {
      "title": "Vault Item",
      "description": "An extracted genetic fragment stored in the user's private vault.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "district": { "type": "string" },
        "fragment": { "type": "string" },
        "sync_integrity": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["name", "district", "fragment", "timestamp"]
    },
    "Message": {
      "title": "Message",
      "description": "A telemetry log or chat message.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "ai", "system"] },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "type": { "type": "string" },
        "context": { "type": "string" }
      },
      "required": ["role", "text", "timestamp"]
    },
    "ConnectivityTest": {
      "title": "Connectivity Test",
      "description": "A document used to test Firebase connectivity.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/artifacts/{appId}/public/data/vision_node/current_state": {
      "schema": "VisionState",
      "description": "Public vision node state."
    },
    "/artifacts/{appId}/public/connectivity": {
      "schema": "ConnectivityTest",
      "description": "Used to test database connection."
    },
    "/artifacts/{appId}/users/{userId}/vault/{itemId}": {
      "schema": "VaultItem",
      "description": "User's private vault items."
    },
    "/artifacts/{appId}/users/{userId}/messages/{messageId}": {
      "schema": "Message",
      "description": "User's session telemetry logs."
    }
  }
}
