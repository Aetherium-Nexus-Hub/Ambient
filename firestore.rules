rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidVaultItem(data) {
      return data.keys().hasAll(['name', 'district', 'fragment', 'timestamp'])
          && data.keys().size() <= 5
          && data.name is string && data.name.size() <= 100
          && data.district is string && data.district.size() <= 100
          && data.fragment is string && data.fragment.size() <= 100
          && data.timestamp is number;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'text', 'timestamp'])
          && data.keys().size() <= 5
          && data.role in ['user', 'ai', 'system']
          && data.text is string && data.text.size() <= 5000
          && data.timestamp is number;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Artifacts Hierarchy
    match /artifacts/{appId} {
      match /public/data/vision_node/current_state {
        allow get: if isValidId(appId);
      }

      match /public/connectivity {
        allow get: if isValidId(appId) && isSignedIn();
      }

      match /users/{userId} {
        allow read: if isOwner(userId);

        match /vault/{itemId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId) && isValidId(itemId);
          allow create: if isVerifiedOwner(userId) && isValidId(itemId) && isValidVaultItem(incoming());
          // Items are immutable for users
        }

        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId) && isValidId(messageId);
          allow create: if isVerifiedOwner(userId) && isValidId(messageId) && isValidMessage(incoming());
          // Messages are immutable for users
        }
      }
    }
  }
}
