rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'text', 'timestamp']) &&
             data.keys().size() <= 6 &&
             data.role in ['system', 'user', 'ai'] &&
             data.text is string && data.text.size() <= 10000 &&
             data.timestamp is int;
    }

    function isValidVaultItem(data) {
      return data.keys().hasAll(['name', 'timestamp']) &&
             data.keys().size() <= 10 &&
             data.name is string && data.name.size() <= 500 &&
             data.timestamp is int;
    }

    match /artifacts/{appId} {
      match /users/{userId} {
        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidMessage(incoming());
          allow update, delete: if isOwner(userId);
        }

        match /vault/{itemId} {
          allow list: if isOwner(userId);
          allow get: if isOwner(userId);
          allow create: if isOwner(userId) && isValidVaultItem(incoming());
          allow update, delete: if isOwner(userId);
        }
      }

      match /public/data/vision_node/current_state {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
